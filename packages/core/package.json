{
  "name": "@buildstory/core",
  "version": "0.1.0",
  "description": "Reconstruct a chronological development timeline and generate an LLM narrative script from git history, planning artifacts, and coding-agent transcripts. ESM-only.",
  "keywords": ["buildstory", "git", "timeline", "changelog", "narrative", "llm", "documentary"],
  "license": "MIT",
  "author": "John Turner",
  "homepage": "https://github.com/johnzilla/build-story#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnzilla/build-story.git",
    "directory": "packages/core"
  },
  "bugs": { "url": "https://github.com/johnzilla/build-story/issues" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "files": ["dist/"],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "gray-matter": "^4.0.3",
    "openai": "^6.49.0",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.5"
  }
}
