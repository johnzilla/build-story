{
  "name": "@buildstory/video",
  "version": "0.1.0",
  "description": "Remotion video rendering and OpenAI TTS for BuildStory narrative scripts. ESM-only. Ships src/ so the Remotion bundler can compile the composition at render time.",
  "keywords": ["buildstory", "remotion", "video", "tts", "narration", "documentary"],
  "license": "MIT",
  "author": "John Turner",
  "homepage": "https://github.com/johnzilla/build-story#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnzilla/build-story.git",
    "directory": "packages/video"
  },
  "bugs": { "url": "https://github.com/johnzilla/build-story/issues" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22" },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./pricing": {
      "import": "./dist/tts/pricing.js",
      "types": "./dist/tts/pricing.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "src/",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@buildstory/core": "workspace:*",
    "@remotion/bundler": "4.0.446",
    "@remotion/renderer": "4.0.446",
    "openai": "^6.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "4.0.446",
    "subtitle": "^4.2.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "vitest": "^4.1.11"
  }
}
