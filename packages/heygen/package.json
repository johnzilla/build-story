{
  "name": "@buildstory/heygen",
  "version": "0.1.0",
  "description": "HeyGen avatar video rendering for BuildStory narrative scripts. ESM-only.",
  "keywords": ["buildstory", "heygen", "avatar", "video", "documentary"],
  "license": "MIT",
  "author": "John Turner",
  "homepage": "https://github.com/johnzilla/build-story#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnzilla/build-story.git",
    "directory": "packages/heygen"
  },
  "bugs": { "url": "https://github.com/johnzilla/build-story/issues" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22" },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@buildstory/core": "workspace:*",
    "p-retry": "^6.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "tsup": "^8.5.1",
    "vitest": "^4.1.11"
  }
}
