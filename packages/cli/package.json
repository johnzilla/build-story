    "fast-glob": "^3.3.3",
    "ora": "^9.4.1",
    "simple-git": "^3.36.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "vitest": "^4.1.11"
  }
