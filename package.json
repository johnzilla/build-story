{
  "name": "build-story",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter '@buildstory/core' build && pnpm --filter '@buildstory/video' build && pnpm --filter '@buildstory/heygen' build && pnpm --filter '@buildstory/cli' build",
    "test": "pnpm --filter '*' test",
    "typecheck": "pnpm --filter '@buildstory/core' typecheck && pnpm --filter '@buildstory/video' typecheck && pnpm --filter '@buildstory/heygen' typecheck && pnpm --filter '@buildstory/cli' typecheck",
    "lint": "eslint packages/*/src",
    "format": "prettier --write .",
    "audit": "pnpm audit --audit-level=high",
    "clean": "pnpm --filter '*' exec -- rm -rf dist"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.0.16",
      "postcss@<8.5.23": "^8.5.23",
      "ws@>=8.0.0 <8.20.1": "^8.20.1",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-jmr9-qjv8-65gv"
      ]
    }
  }
}
