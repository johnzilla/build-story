{
  "name": "build-story",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter '@buildstory/core' build && pnpm --filter '@buildstory/video' build && pnpm --filter 'buildstory' build",
    "test": "pnpm --filter '*' test",
    "lint": "eslint packages/*/src",
    "format": "prettier --write .",
    "clean": "pnpm --filter '*' exec -- rm -rf dist"
  },
  "dependencies": {
    "buildstory": "workspace:*"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.0.16",
      "postcss@<8.5.23": "^8.5.23",
      "ws@>=8.0.0 <8.20.1": "^8.20.1",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1"
    }
  }
}
